# Copy this file to .env and fill in real values. Never commit .env.

# --- Backend / database ---
DATABASE_URL=sqlite:///./patients.db
# Example for Postgres instead: postgresql://user:pass@host:5432/patients

# --- Voice platform (Vapi) ---
# Used only by scripts/create_vapi_assistant.py, not by the running API.
VAPI_API_KEY=
DEPLOYED_BASE_URL=https://your-app.example.com
